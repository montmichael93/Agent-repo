{
  "Mode": "LocalBroker",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Relay": {
    "Namespace": "my-agent-relay.servicebus.windows.net",
    "ConnectionName": "agent-x",
    "KeyName": "listen-only",
    "Key": "replace-me-or-use-entra-id",
    "UseEntraId": false,
    "AgentBaseAddress": "https://localhost:5001",
    "KeepAliveInterval": "00:00:30"
  },
  "LocalBroker": {
    "Uri": "ws://localhost:7000",
    "ListenerSecret": "dev-listener-secret",
    "KeepAliveInterval": "00:00:15"
  }
}
